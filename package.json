{
  "name": "typescript-react-hooks-kit",
  "version": "0.13.0",
  "description": "A polished collection of reusable React hooks written in TypeScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./useAsync": {
      "types": "./dist/hooks/useAsync.d.ts",
      "import": "./dist/hooks/useAsync.mjs",
      "require": "./dist/hooks/useAsync.cjs"
    },
    "./useDebounce": {
      "types": "./dist/hooks/useDebounce.d.ts",
      "import": "./dist/hooks/useDebounce.mjs",
      "require": "./dist/hooks/useDebounce.cjs"
    },
    "./useFetch": {
      "types": "./dist/hooks/useFetch.d.ts",
      "import": "./dist/hooks/useFetch.mjs",
      "require": "./dist/hooks/useFetch.cjs"
    },
    "./useForm": {
      "types": "./dist/hooks/useForm.d.ts",
      "import": "./dist/hooks/useForm.mjs",
      "require": "./dist/hooks/useForm.cjs"
    },
    "./useInterval": {
      "types": "./dist/hooks/useInterval.d.ts",
      "import": "./dist/hooks/useInterval.mjs",
      "require": "./dist/hooks/useInterval.cjs"
    },
    "./useLocalStorage": {
      "types": "./dist/hooks/useLocalStorage.d.ts",
      "import": "./dist/hooks/useLocalStorage.mjs",
      "require": "./dist/hooks/useLocalStorage.cjs"
    },
    "./useMediaQuery": {
      "types": "./dist/hooks/useMediaQuery.d.ts",
      "import": "./dist/hooks/useMediaQuery.mjs",
      "require": "./dist/hooks/useMediaQuery.cjs"
    },
    "./useOnClickOutside": {
      "types": "./dist/hooks/useOnClickOutside.d.ts",
      "import": "./dist/hooks/useOnClickOutside.mjs",
      "require": "./dist/hooks/useOnClickOutside.cjs"
    },
    "./usePrevious": {
      "types": "./dist/hooks/usePrevious.d.ts",
      "import": "./dist/hooks/usePrevious.mjs",
      "require": "./dist/hooks/usePrevious.cjs"
    },
    "./useThrottle": {
      "types": "./dist/hooks/useThrottle.d.ts",
      "import": "./dist/hooks/useThrottle.mjs",
      "require": "./dist/hooks/useThrottle.cjs"
    },
    "./useToggle": {
      "types": "./dist/hooks/useToggle.d.ts",
      "import": "./dist/hooks/useToggle.mjs",
      "require": "./dist/hooks/useToggle.cjs"
    },
    "./useWindowSize": {
      "types": "./dist/hooks/useWindowSize.d.ts",
      "import": "./dist/hooks/useWindowSize.mjs",
      "require": "./dist/hooks/useWindowSize.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "useAsync": [
        "dist/hooks/useAsync.d.ts"
      ],
      "useDebounce": [
        "dist/hooks/useDebounce.d.ts"
      ],
      "useFetch": [
        "dist/hooks/useFetch.d.ts"
      ],
      "useForm": [
        "dist/hooks/useForm.d.ts"
      ],
      "useInterval": [
        "dist/hooks/useInterval.d.ts"
      ],
      "useLocalStorage": [
        "dist/hooks/useLocalStorage.d.ts"
      ],
      "useMediaQuery": [
        "dist/hooks/useMediaQuery.d.ts"
      ],
      "useOnClickOutside": [
        "dist/hooks/useOnClickOutside.d.ts"
      ],
      "usePrevious": [
        "dist/hooks/usePrevious.d.ts"
      ],
      "useThrottle": [
        "dist/hooks/useThrottle.d.ts"
      ],
      "useToggle": [
        "dist/hooks/useToggle.d.ts"
      ],
      "useWindowSize": [
        "dist/hooks/useWindowSize.d.ts"
      ],
      "*": [
        "dist/*"
      ]
    }
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "format:check": "prettier --check .",
    "lint": "oxlint .",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "release:dry-run": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run pack:check && npm publish --dry-run --access public",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "typescript",
    "utility-hooks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamjpena/typescript-react-hooks-kit.git"
  },
  "bugs": {
    "url": "https://github.com/adamjpena/typescript-react-hooks-kit/issues"
  },
  "homepage": "https://github.com/adamjpena/typescript-react-hooks-kit#readme",
  "author": "Adam Peña",
  "license": "MIT",
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
